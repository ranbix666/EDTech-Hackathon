# Required only when the server supplies the Gemini key.
# If omitted, individual users can provide a key in the browser.
GEMINI_API_KEY=

# Current default. Override this to evaluate a different compatible model.
GEMINI_MODEL=gemini-3.7-flash

# Basic per-process protection for /challenge and /unlock.
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000

# Local development defaults to enabled; production defaults to disabled.
# Set explicitly to true only for an approved research deployment.
STUDY_LOGGING_ENABLED=false

# Optional. Relative paths are resolved from essay-tutor/.
STUDY_LOG_DIR=study-logs

# Enable only when Express is behind a trusted reverse proxy.
TRUST_PROXY=false
